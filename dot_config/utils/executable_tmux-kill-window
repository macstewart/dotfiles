#!/usr/bin/env bash

# Closes the current tmux window. For worktree windows (wt|<name>), tears the
# worktree down via workmux (which removes the window itself); falls back to a
# plain kill-window if that fails or it isn't a worktree window.

window_name=$(tmux display-message -p '#W')

if [[ "$window_name" == wt\|* ]]; then
    handle="${window_name#wt|}"
    handle="${handle%% *}"
    session_dir=$(tmux display-message -p '#{session_path}')
    if (cd "$session_dir" && workmux remove --force "$handle"); then
        exit 0
    fi
    tmux display-message "workmux remove failed for $handle; killing window"
fi

tmux kill-window
