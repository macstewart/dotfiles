#!/usr/bin/env bash
num=$(echo "$1" | tr -d '#')
jq -r --argjson n "$num" '
  .[] | select(.number == $n) |
  "PR #\(.number)\n" +
  "Title: \(.title)\n" +
  "Author: \(.author.login)\n" +
  "Branch: \(.headRefName)\n" +
  "Draft: \(if .isDraft then "yes" else "no" end)\n" +
  "───────────────────────────────"
' "$2"

# glow sees a pipe under fzf and would otherwise strip colour
jq -r --argjson n "$num" '.[] | select(.number == $n) | .body // "No description"' "$2" \
  | CLICOLOR_FORCE=1 glow -s dark -w "${FZF_PREVIEW_COLUMNS:-80}" -
