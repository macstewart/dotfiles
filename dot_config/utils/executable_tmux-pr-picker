#!/usr/bin/env bash

repo=$(tmux display-message -p '#{session_name}')
org="SolaceDev"
full_repo="${org}/${repo}"

prs=$(gh pr list --repo="$full_repo" --search="-label:dependabot" --json number,title,author,headRefName,body --limit 50 2>&1)

if [[ $? -ne 0 || -z "$prs" || "$prs" == "[]" ]]; then
    echo "No open PRs found for $full_repo"
    read -n 1
    exit 1
fi

tmpfile=$(mktemp)
echo "$prs" > "$tmpfile"
trap 'rm -f "$tmpfile"' EXIT

selected=$(jq -r '.[] | "#\(.number)\t\(.title) [\(.author.login)]"' "$tmpfile" \
    | fzf --height 100% \
           --border-label " ${full_repo} PRs " \
           --info hidden --no-scrollbar \
           --delimiter $'\t' \
           --with-nth '1..' \
           --preview "$HOME/.config/utils/tmux-pr-preview {1} $tmpfile" \
           --preview-window right,60%,wrap)

if [[ -z "$selected" ]]; then
    exit 0
fi

pr_number=$(echo "$selected" | cut -f1 | tr -d '#')
pr_json=$(jq --argjson n "$pr_number" '.[] | select(.number == $n)' "$tmpfile")
title=$(echo "$pr_json" | jq -r '.title')

# Generate prompt file — delegate the review criteria to the wm-pr-review skill
promptfile=$(mktemp "${TMPDIR:-/tmp}/pr-prompt-XXXXXX.md")
cat > "$promptfile" << EOF
Use the wm-pr-review skill to review this pull request (${full_repo}#${pr_number}: ${title}).
EOF

session_dir=$(tmux display-message -p '#{session_path}')

# Snapshot existing windows so we can find the one workmux creates below
before_ids=$(tmux list-windows -a -F '#{window_id}' | sort)

cd "$session_dir" && workmux add --pr "$pr_number" \
    --background \
    --prompt-file "$promptfile"

rm -f "$promptfile"

# Tag the review window with a per-window user option instead of renaming it.
# tmux.style.conf keys the yellow "CR" styling off @wt_cr, so the window keeps
# its original wt|<handle> name — renaming it would desync the name workmux
# reconstructs on `workmux rm`, leaving the window un-killed.
new_id=$(comm -13 <(echo "$before_ids") \
    <(tmux list-windows -a -F '#{window_id}' | sort) | head -1)
if [[ -n "$new_id" ]]; then
    tmux set-option -w -t "$new_id" @wt_cr 1
fi
